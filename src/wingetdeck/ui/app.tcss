/* Colours and layout follow the approved mock. Green dark is the default theme. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
}

Footer {
    background: $panel;
}

FooterKey {
    background: $panel;
    color: $foreground;
}

FooterKey .footer-key--key {
    background: $panel;
    color: $wd-key;
    text-style: bold;
}

FooterKey .footer-key--description {
    background: $panel;
    color: $foreground;
}

/* Buttons: bright top edge, dark bottom edge, like the mock */

Button {
    min-width: 10;
    height: 3;
    text-style: bold;
    line-pad: 1;
    background: $wd-green;
    color: $wd-green-text;
    border: none;
    border-top: tall $wd-green-top;
    border-bottom: tall $wd-green-low;
}

Button:hover {
    background: $wd-green-top;
    color: $wd-green-text;
    border-top: tall $wd-green-top;
    border-bottom: tall $wd-green-low;
}

Button:focus {
    text-style: bold underline;
}

Button.-active {
    background: $wd-green-low;
    tint: transparent;
}

Button.blue {
    background: $wd-blue;
    color: white;
    border-top: tall $wd-blue-top;
    border-bottom: tall $wd-blue-low;
}

Button.blue:hover {
    background: $wd-blue-top;
    color: white;
    border-top: tall $wd-blue-top;
    border-bottom: tall $wd-blue-low;
}

Button.red {
    background: $wd-red;
    color: white;
    border-top: tall $wd-red-top;
    border-bottom: tall $wd-red-low;
}

Button.red:hover {
    background: $wd-red-top;
    color: white;
    border-top: tall $wd-red-top;
    border-bottom: tall $wd-red-low;
}

Button.gray {
    background: $wd-gray;
    color: $foreground;
    border-top: tall $wd-gray-top;
    border-bottom: tall $wd-gray-low;
}

Button.gray:hover {
    background: $wd-gray-top;
    color: $foreground;
    border-top: tall $wd-gray-top;
    border-bottom: tall $wd-gray-low;
}

Button:disabled {
    background: $wd-off;
    color: $wd-off-text;
    border-top: tall $wd-off;
    border-bottom: tall $wd-off;
    opacity: 100%;
}

/* Splash */

#splash-body {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#logo {
    margin-bottom: 1;
}

#prompt {
    width: auto;
    margin-bottom: 1;
}

#splash-row {
    width: auto;
    max-width: 100%;
    height: auto;
}

#sources {
    width: 40;
    height: auto;
    max-height: 8;
    background: $wd-list;
    margin-right: 1;
}

#sources > ListItem {
    background: $wd-list;
    padding: 0 1;
}

#sources > ListItem:hover {
    background: $panel;
}

#sources > ListItem.-highlight {
    background: $wd-blue;
    color: white;
    text-style: bold;
}

#splash-row Button {
    margin-right: 1;
}

#versions {
    width: auto;
    color: $wd-dim;
    margin-top: 1;
}

#notes {
    width: auto;
    max-width: 100%;
    height: auto;
    color: $warning;
}

/* Winget missing */

#no-winget-body {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

#help {
    width: auto;
    max-width: 90;
    height: auto;
    margin-bottom: 1;
}

#no-winget-buttons {
    width: auto;
    height: auto;
}

#no-winget-buttons Button {
    margin-right: 1;
}

/* Package table */

#packages-body {
    width: 100%;
    height: 1fr;
}

#filter {
    height: 3;
    border: tall $wd-blue;
}

PackageTable {
    width: 100%;
    height: auto;
    background: $background;
    scrollbar-size-vertical: 1;
}

PackageTable > .table--header {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

PackageTable > .table--cursor {
    background: $wd-blue;
    color: white;
    text-style: bold;
}

PackageTable > .table--hover {
    background: $panel;
}

PackageTable > .table--ticked {
    color: $wd-lime;
    text-style: bold;
}

PackageTable > .table--unticked {
    color: $wd-dim;
}

PackageTable > .table--major {
    color: $wd-major;
}

PackageTable > .table--minor {
    color: $wd-minor;
}

PackageTable > .table--patch {
    color: $wd-lime;
}

PackageTable > .table--unknown {
    color: $wd-dim;
}

PackageTable > .table--new {
    background: $wd-cyan;
    color: black;
    text-style: bold;
}

PackageTable > .table--note {
    color: $wd-dim;
}

#empty {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    color: $wd-lime;
}

#table-actions {
    width: 100%;
    height: 3;
}

#table-actions Button {
    margin-right: 1;
}

#actions-gap {
    width: 1fr;
    height: 1;
}

#table-log-box {
    width: 100%;
    height: 1fr;
    border-top: solid $wd-blue;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#table-log {
    width: 100%;
    height: auto;
}

#upgrade {
    width: 16;
}

/* Progress screen */

#run-top {
    width: 100%;
    height: 3;
}

#run-top Button {
    margin-right: 1;
    width: auto;
}

#run-name {
    width: auto;
    max-width: 34;
    height: 3;
    padding: 1 2;
    background: $wd-blue;
    color: white;
    text-style: bold;
    margin-right: 1;
}

#chip {
    width: auto;
    height: 1;
    margin: 1 1 0 0;
    padding: 0 1;
    text-style: bold;
}

#chip.chip-busy {
    background: $wd-cyan;
    color: black;
}

#chip.chip-hold {
    background: $wd-minor;
    color: black;
}

#chip.chip-good {
    background: $wd-lime;
    color: black;
}

#chip.chip-bad {
    background: $wd-major;
    color: black;
}

#run-count {
    width: auto;
    height: 1;
    margin-top: 1;
    color: $wd-dim;
}

#run-gap {
    width: 1fr;
    height: 1;
}

#run-mid {
    width: 100%;
    height: 8;
    padding: 0 1;
}

#run-icon {
    width: 18;
    height: 8;
}

#run-meters {
    width: 1fr;
    height: 8;
    padding: 1 2 0 0;
}

#meter-speed {
    color: $wd-cyan;
    margin-bottom: 1;
}

#meter-received {
    color: $secondary;
}

#run-state {
    width: 34;
    height: 8;
    padding-top: 1;
}

#percent {
    color: $wd-lime;
    margin-bottom: 1;
}

#stages {
    color: $wd-dim;
}

#summary {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $wd-lime;
    text-style: bold;
}

#item-notes {
    width: 100%;
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $wd-major;
}

#notice {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $warning;
}

#run-tabs {
    width: 100%;
    height: 1;
    padding: 0 1;
}

#run-tabs Button {
    margin-right: 1;
    min-width: 8;
}

#run-bottom {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#log-box {
    width: 3fr;
    height: 100%;
    border: solid $wd-cyan;
    border-title-color: $wd-cyan;
    border-title-style: bold;
    margin-right: 1;
}

#queue-box {
    width: 2fr;
    height: 100%;
    border: solid $wd-cyan;
    border-title-color: $wd-cyan;
    border-title-style: bold;
}

#run-log {
    background: $background;
    scrollbar-size-vertical: 1;
}

#queue {
    scrollbar-size-vertical: 1;
}

.queue-row {
    width: 100%;
    height: 1;
}

.queue-name {
    width: 1fr;
    height: 1;
}

.state-active {
    color: $wd-cyan;
    text-style: bold;
}

.state-done, .state-done_restart {
    color: $wd-lime;
}

.state-failed {
    color: $wd-major;
}

.state-stopped, .state-skipped {
    color: $wd-dim;
}

Button.queue-button {
    width: 3;
    min-width: 3;
    height: 1;
    margin-left: 1;
    background: $wd-gray;
    color: $foreground;
    border: none;
}

Button.queue-remove {
    background: $wd-red;
    color: white;
}

/* Dialogs */

ConfirmDialog {
    align: center middle;
    background: black 70%;
}

#dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    background: $surface;
    border: solid $wd-red;
    padding: 1 2;
}

#dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

#dialog-text {
    margin-bottom: 1;
}

#dialog-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
}

#dialog-buttons Button {
    width: auto;
    margin-left: 1;
}
